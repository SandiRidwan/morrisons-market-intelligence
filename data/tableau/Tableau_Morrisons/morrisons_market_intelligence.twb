  <datasources>
    <datasource hasconnection='true' inline='true' name='federated.morrisons' caption='Morrisons Products' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='Morrisons Products' name='hyper.morrisons'>
            <connection class='hyper' dbname='F:/PROJECT/Data Analyst Project/morrisons-market-intelligence/data/tableau/Tableau_Morrisons/products.hyper' schema='Extract' tablename='Extract' />
          </named-connection>
        </named-connections>
        <relation connection='hyper.morrisons' name='Extract' table='[Extract].[Extract]' type='table' />
      </connection>
      <column datatype='string' name='[Category]' role='dimension' type='nominal' />
      <column datatype='string' name='[Subcategory]' role='dimension' type='nominal' />
      <column datatype='string' name='[Brand]' role='dimension' type='nominal' />
      <column datatype='string' name='[Price Tier]' role='dimension' type='nominal' />
      <column datatype='string' name='[Product]' role='dimension' type='nominal' />
      <column datatype='boolean' name='[Is Promo]' role='dimension' type='nominal' />
      <column datatype='real' name='[Effective Price]' role='measure' type='quantitative' />
      <column datatype='real' name='[Price per 100g]' role='measure' type='quantitative' />
      <column datatype='real' name='[Rating]' role='measure' type='quantitative' />
      <column datatype='integer' name='[Reviews]' role='measure' type='quantitative' />
      <column datatype='real' name='[Discount Pct]' role='measure' type='quantitative' />
      <column datatype='real' name='[Value Score]' role='measure' type='quantitative' />
      <column caption='Avg Price' datatype='real' name='[AvgPrice]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Effective Price])' />
      </column>
      <column caption='Avg Rating' datatype='real' name='[AvgRating]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Rating])' />
      </column>
      <column caption='Avg Unit Price' datatype='real' name='[AvgUnit]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Price per 100g])' />
      </column>
      <column caption='Avg Discount' datatype='real' name='[AvgDiscount]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Discount Pct])' />
      </column>
      <column caption='Products' datatype='integer' name='[Products]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Product])' />
      </column>
      <column caption='Avg Value Score' datatype='real' name='[AvgValue]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Value Score])' />
      </column>
      <layout dim-percentage='0.5' measure-percentage='0.5' dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
