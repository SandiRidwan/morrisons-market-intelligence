# Data mentah besar — tidak di-commit (45 MB; sumber ada di repo scraper)
data/raw/*.csv
data/raw/*.rar
!data/raw/.gitkeep

# Data turunan: data bersih DI-COMMIT agar app bisa langsung jalan (~15 MB).
# File besar lain diabaikan.
data/processed/*.csv
!data/processed/morrisons_clean.csv
!data/processed/.gitkeep

# Tableau: commit bundel siap-pakai (.hyper + .tds + panduan), abaikan CSV besar
data/tableau/*.csv
!data/tableau/Tableau_Morrisons/
data/tableau/Tableau_Morrisons/*.csv
hyperd.log

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.egg-info/
.venv/
venv/
env/

# Scraper (repo terpisah, hanya di-clone lokal)
scraper/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
_probe*.py

# Tableau recovery files
data/tableau/**/~*

# Kredensial (JANGAN pernah commit)
kunci.json
*.json.key
credentials.json
*service_account*
